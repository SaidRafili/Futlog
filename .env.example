# Local: copy to .env.local (git-ignored). On Vercel: Project -> Settings -> Environment Variables.
# Use the pooled connection string from Neon (host contains "-pooler").
# The database name at the end of the URL is IGNORED: the app always uses the database "teams".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional: use a different database name than "teams"
# DB_NAME=teams

# Public address of the site, used for link previews (Open Graph / Twitter cards). Needed for a custom domain;
# on Vercel the deployment address is used automatically when this is not set.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Reply notifications by Gmail. Leave these out to switch e-mails off (nothing is sent, nothing breaks).
# GMAIL_APP_PASSWORD is NOT your normal Gmail password: turn on 2-Step Verification for the account, then create an
# "App password" at https://myaccount.google.com/apppasswords and paste the 16 characters here (spaces are fine).
# GMAIL_USER=your.address@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Optional sender name shown in the inbox (default "Futlog")
# MAIL_FROM_NAME=Futlog
