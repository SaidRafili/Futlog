# Local: copy to .env.local (git-ignored). On Vercel: Project -> Settings -> Environment Variables.
# Use the pooled connection string from Neon (host contains "-pooler").
# The database name at the end of the URL is IGNORED: the app always uses the database "teams".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional: use a different database name than "teams"
# DB_NAME=teams

# Email verification codes (sign-up and sign-in) are sent from this Gmail account through SMTP.
# GMAIL_APP_PASSWORD must be a Google "App password" (Google Account -> Security -> 2-Step Verification -> App passwords),
# NOT the normal Gmail password. Without it, codes are only printed in the server console in development and
# sending fails in production.
GMAIL_USER=futlogcom@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
