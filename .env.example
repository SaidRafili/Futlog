# Local: copy to .env.local (git-ignored). On Vercel: add the same variable under
# Project -> Settings -> Environment Variables (or use the Neon integration, which adds it for you).
# Use the pooled connection string from the Neon dashboard (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
